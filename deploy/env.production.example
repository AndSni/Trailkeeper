# Server .env - copy to /home/asnidev/trailkeeper/backend/.env on the server
# and fill in real values. This file is NEVER synced from a dev machine
# (scripts/deploy_backend.sh excludes .env), so production values are safe.

# Dedicated database + role on the shared Postgres instance. Create with:
#   sudo -u postgres createuser --pwprompt trailkeeper
#   sudo -u postgres createdb --owner trailkeeper trailkeeper
DATABASE_URL=postgresql+psycopg://trailkeeper:CHANGE_ME@127.0.0.1:5432/trailkeeper

# Generate once:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME

ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# Leave registration ON for the very first sign-up (it bootstraps the owner +
# organisation), then set to false and restart the service.
ALLOW_REGISTRATION=true
INVITE_TTL_DAYS=14

# Web console origins (Phase 6), comma-separated. Empty disables CORS.
CORS_ORIGINS=
