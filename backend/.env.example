# Copy to .env and adjust. .env is gitignored.

# Local dev reuses the same Postgres cluster as SharpRight via its own database.
DATABASE_URL=postgresql+psycopg://sharpright:sharpright_dev@127.0.0.1:5432/trailkeeper

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me

ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# Turn off once the first organisation exists.
ALLOW_REGISTRATION=true
INVITE_TTL_DAYS=14

# Web console origins (Phase 6), comma-separated. Empty disables CORS.
CORS_ORIGINS=
